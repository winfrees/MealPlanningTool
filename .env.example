# Copy to .env (never committed). All settings use the MEALPLAN_ prefix.
MEALPLAN_DB_PATH=mealplan.db
MEALPLAN_DATA_DIR=data
# Anthropic API key (starts with sk-ant-); ANTHROPIC_API_KEY also works. Or paste it on the
# web app's Setup page, which checks it and writes this line for you.
MEALPLAN_ANTHROPIC_API_KEY=
MEALPLAN_AGENT_WEEKLY_BUDGET_USD=10
# Web app (mealctl serve): the household password
MEALPLAN_WEB_PASSWORD=
